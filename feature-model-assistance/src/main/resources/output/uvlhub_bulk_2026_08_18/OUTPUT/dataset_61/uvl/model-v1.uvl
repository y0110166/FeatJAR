features
        Module
                optional
                        SpinningRadar
                optional
                        HeadOnTargeting
                        LinearTargeting
                        MouseTargeting
                optional
                        QuietMovement
                optional
                        WeakestSelectEnemy
                        Strongest
                        ClosestSelectEnemy
                optional
                        MaximumPowerGun
                        NoFireGun
                        MouseClickGun

constraints
        !(Module) | HeadOnTargeting | LinearTargeting | MouseTargeting
        !(MouseTargeting) | !(LinearTargeting) | !(Module)
        !(LinearTargeting) | !(HeadOnTargeting) | !(Module)
        !(MouseTargeting) | !(HeadOnTargeting) | !(Module)
        !(Module) | MaximumPowerGun | NoFireGun | MouseClickGun
        !(MouseClickGun) | !(NoFireGun) | !(Module)
        !(NoFireGun) | !(MaximumPowerGun) | !(Module)
        !(MouseClickGun) | !(MaximumPowerGun) | !(Module)
        !(Module) | WeakestSelectEnemy | Strongest | ClosestSelectEnemy
        !(ClosestSelectEnemy) | !(Strongest) | !(Module)
        !(ClosestSelectEnemy) | !(WeakestSelectEnemy) | !(Module)
        !(Strongest) | !(WeakestSelectEnemy) | !(Module)
