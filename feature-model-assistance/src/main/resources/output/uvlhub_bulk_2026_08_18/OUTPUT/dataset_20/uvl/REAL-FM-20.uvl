constraints
        !(global_life) | !(single) | !(thread)
        !(minimal_set) | !(single) | !(thread)
        !(thread_strategy_replugging) | thread_fcfs | thread_lcfs | priority_16 | priority_32 | priority_8
        !(thread_schedule) | thread_fcfs | thread_lcfs | priority_16 | priority_32 | priority_8
        !(priority_behaviour) | !(thread_strategy_replugging) | !(thread_fcfs)
        !(priority_behaviour) | !(thread_strategy_replugging) | !(thread_lcfs)
        !(thread_strategy_replugging) | !(thread_lcfs) | !(thread_fcfs)
        !(priority_behaviour) | !(thread_fcfs) | !(thread_schedule)
        !(priority_behaviour) | !(thread_lcfs) | !(thread_schedule)
        !(thread_lcfs) | !(thread_fcfs) | !(thread_schedule)
