                                        global_life
                                                optional
                                                        thread_schedule
                                                                optional
                                                                        thread_strategy_replugging
                                                                        bundle_schedule
                                                                                optional
                                                                                        bundle_strategy_replugging
                                                                                optional
                                                                                        bundle_preemption
                                                                                alternative
                                                                                        bundle_fcfs
                                                                                        bundle_lcfs
                                                                        idle_control
                                                                                alternative
                                                                                        idle_guard
                                                                                        idle_panic
                                                                                        idle_user
                                                                        query_schedule
                                                                optional
