        !(PatternsTrendsAndExceptions) | !(PreciseValues) | !(CompareIndividualValues)
        !(EntireSeriesOfValues) | !(PreciseValues) | !(CompareIndividualValues)
        !(EntireSeriesOfValues) | !(PatternsTrendsAndExceptions) | !(CompareIndividualValues)
        !(PreciseValues) | !(CompareIndividualValues) | !(IndividualValues)
        !(PatternsTrendsAndExceptions) | !(CompareIndividualValues) | !(IndividualValues)
        !(EntireSeriesOfValues) | !(CompareIndividualValues) | !(IndividualValues)
