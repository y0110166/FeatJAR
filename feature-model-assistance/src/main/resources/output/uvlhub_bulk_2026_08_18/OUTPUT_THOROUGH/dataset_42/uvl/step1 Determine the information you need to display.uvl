features
        Visualization {abstract true}
                optional
                        IndividualValues {abstract true}
                        CompareIndividualValues {abstract true}
                        PreciseValues {abstract true}
                        PatternsTrendsAndExceptions {abstract true}
                        MoreThanOneUnitOfMeasure {abstract true}
                        VariousLevelsOfAggregation {abstract true}
                        EntireSeriesOfValues {abstract true}
                optional
                        Graph

constraints
        PatternsTrendsAndExceptions => Graph
        EntireSeriesOfValues => Graph
        !(Visualization) | IndividualValues | CompareIndividualValues | PreciseValues | PatternsTrendsAndExceptions | MoreThanOneUnitOfMeasure | VariousLevelsOfAggregation | EntireSeriesOfValues
