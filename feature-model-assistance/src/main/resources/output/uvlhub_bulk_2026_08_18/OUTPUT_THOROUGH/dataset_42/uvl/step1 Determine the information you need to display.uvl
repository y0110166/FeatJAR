        !(EntireSeriesOfValues) | !(MoreThanOneUnitOfMeasure) | !(CompareIndividualValues)
        !(MoreThanOneUnitOfMeasure) | !(PatternsTrendsAndExceptions) | !(PreciseValues)
        !(EntireSeriesOfValues) | !(MoreThanOneUnitOfMeasure) | !(PreciseValues)
        !(EntireSeriesOfValues) | !(MoreThanOneUnitOfMeasure) | !(PatternsTrendsAndExceptions)
        !(MoreThanOneUnitOfMeasure) | !(PreciseValues) | !(IndividualValues)
        !(MoreThanOneUnitOfMeasure) | !(CompareIndividualValues) | !(IndividualValues)
        !(VariousLevelsOfAggregation) | !(PreciseValues) | !(CompareIndividualValues)
        !(VariousLevelsOfAggregation) | !(PatternsTrendsAndExceptions) | !(IndividualValues)
        !(VariousLevelsOfAggregation) | !(MoreThanOneUnitOfMeasure) | !(IndividualValues)
        !(EntireSeriesOfValues) | !(VariousLevelsOfAggregation) | !(IndividualValues)
        !(VariousLevelsOfAggregation) | !(PatternsTrendsAndExceptions) | !(CompareIndividualValues)
        !(VariousLevelsOfAggregation) | !(MoreThanOneUnitOfMeasure) | !(CompareIndividualValues)
        !(EntireSeriesOfValues) | !(VariousLevelsOfAggregation) | !(CompareIndividualValues)
        !(VariousLevelsOfAggregation) | !(PatternsTrendsAndExceptions) | !(PreciseValues)
        !(VariousLevelsOfAggregation) | !(MoreThanOneUnitOfMeasure) | !(PreciseValues)
        !(EntireSeriesOfValues) | !(VariousLevelsOfAggregation) | !(PreciseValues)
        !(EntireSeriesOfValues) | !(VariousLevelsOfAggregation) | !(MoreThanOneUnitOfMeasure)
        !(EntireSeriesOfValues) | !(VariousLevelsOfAggregation) | !(PatternsTrendsAndExceptions)
        !(VariousLevelsOfAggregation) | !(MoreThanOneUnitOfMeasure) | !(PatternsTrendsAndExceptions)
        !(VariousLevelsOfAggregation) | !(PreciseValues) | !(IndividualValues)
        !(VariousLevelsOfAggregation) | !(CompareIndividualValues) | !(IndividualValues)
        !(PreciseValues) | !(CompareIndividualValues) | !(Visualization)
        !(PatternsTrendsAndExceptions) | !(IndividualValues) | !(Visualization)
        !(MoreThanOneUnitOfMeasure) | !(IndividualValues) | !(Visualization)
        !(VariousLevelsOfAggregation) | !(IndividualValues) | !(Visualization)
