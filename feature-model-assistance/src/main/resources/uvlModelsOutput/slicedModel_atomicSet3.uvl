features
        root {abstract true, de_featjar_base_data_name 'root'}
                optional
                        f1 {de_featjar_base_data_name 'f1'}
                        f5 {de_featjar_base_data_name 'f5'}
                        f6 {de_featjar_base_data_name 'f6'}
                or
                        f7 {de_featjar_base_data_name 'f7'}
                        f8 {de_featjar_base_data_name 'f8'}
                optional
                        f3 {de_featjar_base_data_name 'f3'}
                        f4 {de_featjar_base_data_name 'f4'}

constraints
        !(f6) | f3 | f4
        !(f4) | !(f3) | !(f6)
        f1 | f3 | f4
        !(f4) | !(f3) | f1
        !(f6) | !(f1)
        !(f4) | !(f1)
        !(f3) | !(f1)
